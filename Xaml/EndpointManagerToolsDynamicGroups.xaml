<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.IsSharedSizeScope='True'>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="TitleColumn" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" TextWrapping="Wrap"
               Text="Create reusable Entra ID dynamic groups used for Intune assignments." />

    <Label Grid.Row="1" Grid.Column="0" Content="Group tag" VerticalAlignment="Center" Margin="0,0,8,0" />
    <TextBox Grid.Row="1" Grid.Column="1" Name="txtAutopilotGroupTag" Text="Pilot"
             ToolTip="OrderID tag used in membership rule, e.g. Pilot" />

    <Label Grid.Row="2" Grid.Column="0" Content="Group name" VerticalAlignment="Center" Margin="0,8,8,0" />
    <TextBox Grid.Row="2" Grid.Column="1" Name="txtAutopilotGroupName" Margin="0,8,0,0"
             Text="Intune-Win-Devices-Autopilot Pilot Group"
             ToolTip="Display name for the dynamic device group." />

    <CheckBox Grid.Row="3" Grid.Column="1" Name="chkAddToDefaultAppsPolicies" Margin="0,8,0,0"
              Content="Add this group to Intune-Default Apps and Policies (create parent group if missing)"
              IsChecked="True" />

    <Button Grid.Row="4" Grid.Column="1" Name="btnCreateAutopilotPilotGroup"
            Content="Create Dynamic Device Group"
            Margin="0,10,0,0"
            MinWidth="260"
            HorizontalAlignment="Left"
            ToolTip="Create dynamic device group using the entered tag and name." />

    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="Rule format: (device.devicePhysicalIds -any (_ -eq &quot;[OrderID]:&lt;GroupTag&gt;&quot;))" />
</Grid>
