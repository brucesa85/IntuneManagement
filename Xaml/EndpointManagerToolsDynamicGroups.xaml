<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
               Text="Create reusable Entra ID dynamic groups used for Intune assignments." />

    <StackPanel Grid.Row="1" Orientation="Vertical">
        <Button Name="btnCreateAutopilotPilotGroup"
                Content="Create Autopilot Pilot Group"
                MinWidth="260"
                HorizontalAlignment="Left"
                ToolTip="Create dynamic device group 'Intune-Win-Devices-Autopilot Pilot Group'" />
    </StackPanel>

    <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="Membership rule: (device.devicePhysicalIds -any (_ -eq &quot;[OrderID]:Pilot&quot;))" />
</Grid>
